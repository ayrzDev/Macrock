+pub trait AccountSwitcher: Send + Sync + 'static {
+    /// Tokens whose user identity is returned to the game.
+    fn game_tokens(&self) -> Arc<TokenManager>;
+    /// Runs on the thread that drives `run_with` (the process main thread, which
+    /// the native sign-in window requires). `true` means a new identity is active.
+    fn switch<'a>(&'a self) -> std::pin::Pin<Box<dyn std::future::Future<Output = bool> + 'a>>;
+}
+
+pub(crate) type SwitchReply = tokio::sync::oneshot::Sender<bool>;
+
 pub async fn run(tokens: Arc<TokenManager>) {
+    run_with(tokens, None).await
+}
