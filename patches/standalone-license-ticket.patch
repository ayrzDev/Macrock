+
+fn license_content_failure(error: LicenseContentError) -> String {
+    match error {
+        LicenseContentError::NotEntitled { code } => {
+            eprintln!("BEDROCK_LICENSE_DIAGNOSTIC:kind=not_entitled;code={code}");
+            format!("not_entitled:{code}")
+        }
+        LicenseContentError::Http(status) => {
+            eprintln!("BEDROCK_LICENSE_DIAGNOSTIC:kind=http;status={status}");
+            "license_transient".to_string()
+        }
+        LicenseContentError::Request(_) | LicenseContentError::MissingKey => {
+            eprintln!("BEDROCK_LICENSE_DIAGNOSTIC:kind=transient");
+            "license_transient".to_string()
+        }
+    }
+}
+
+fn ticket_current(expires: &str) -> bool {
+    chrono::DateTime::parse_from_rfc3339(expires)
+        .is_ok_and(|expires| expires.timestamp() > chrono::Utc::now().timestamp() + 60)
+}
+
+fn ticket_form(value: &str) -> &'static str {
+    if value.starts_with("eyJ") { "jwe" }
+    else if value.starts_with("d=") { "d" }
+    else if value.starts_with("t=") { "t" }
+    else { "plain" }
+}
+
+fn compact_ticket(role: &str, response: soap::RequestSecurityTokenResponse) -> Result<String, String> {
+    if !ticket_current(&response.lifetime.expires) {
+        return Err("license_transient".to_string());
+    }
+    let typed = match response.token_type.as_str() {
+        "urn:passport:compact" => "compact",
+        "urn:passport:delegationcompact" => "delegation",
+        _ => return Err("license_transient".to_string()),
+    };
+    let Some(binary) = response.requested_security_token.binary_security_token
+        .filter(|value| !value.value.is_empty()) else {
+        return Err("license_transient".to_string());
+    };
+    // Xbox prefixes a raw delegation ticket with "d=". A JWE, or a ticket that
+    // already has its prefix, is sent unchanged. Adding "d=" to a JWE makes
+    // the content-license service reject the real owner with HTTP 401.
+    let ticket = if matches!(ticket_form(&binary.value), "jwe" | "d" | "t") {
+        binary.value
+    } else if typed == "delegation" {
+        format!("d={}", binary.value)
+    } else {
+        binary.value
+    };
+    let address = if response.applies_to.endpoint_reference.address == "www.microsoft.com" { "microsoft" } else { "other" };
+    eprintln!("BEDROCK_LICENSE_DIAGNOSTIC:kind=ticket;role={role};typed={typed};form={};address={address}", ticket_form(&ticket));
+    Ok(ticket)
+}
+
+/// Microsoft returns the refreshed legacy STS and the service ticket in either
+/// order. The license request needs the service ticket; the first element is
+/// not that ticket.
+fn license_user_ticket(outcome: ExchangeUserTokenOutcome) -> Result<String, String> {
+    let responses = match outcome {
+        ExchangeUserTokenOutcome::Fault(_) => return Err("license_transient".to_string()),
+        ExchangeUserTokenOutcome::Issued(soap::BodyContent::RequestSecurityTokenResponseCollection(collection)) => {
+            collection.security_tokens
+        }
+        ExchangeUserTokenOutcome::Issued(soap::BodyContent::RequestSecurityTokenResponse(token)) => vec![*token],
+        ExchangeUserTokenOutcome::Issued(_) => return Err("license_transient".to_string()),
+    };
+    let mut ticket = None;
+    for response in responses {
+        if response.token_type == "urn:passport:legacy" {
+            continue;
+        }
+        let value = compact_ticket("user", response)?;
+        if ticket.replace(value).is_some() {
+            return Err("license_transient".to_string());
+        }
+    }
+    ticket.ok_or_else(|| "license_transient".to_string())
+}
