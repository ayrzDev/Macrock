+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn lifetime(expires: &str) -> soap::Timestamp {
+        soap::Timestamp { id: None, created: "2026-01-01T00:00:00Z".into(), expires: expires.into() }
+    }
+
+    fn compact(kind: &str, value: &str, expires: &str) -> soap::RequestSecurityTokenResponse {
+        soap::RequestSecurityTokenResponse {
+            token_type: kind.into(),
+            applies_to: soap::AppliesTo { endpoint_reference: soap::EndpointReference { address: "www.microsoft.com".into() } },
+            lifetime: lifetime(expires),
+            requested_security_token: soap::RequestedSecurityToken {
+                encrypted_data: None,
+                binary_security_token: Some(soap::BinarySecurityTokenRes {
+                    id: "fixture".into(), value: value.into(), value_type: None }),
+            },
+            requested_proof_token: None,
+        }
+    }
+
+    fn issued(responses: Vec<soap::RequestSecurityTokenResponse>) -> ExchangeUserTokenOutcome {
+        ExchangeUserTokenOutcome::Issued(
+            soap::BodyContent::RequestSecurityTokenResponseCollection(
+                soap::RequestSecurityTokenResponseCollection { security_tokens: responses }))
+    }
+
+    #[test]
+    fn license_ticket_uses_the_service_token_when_a_legacy_renewal_comes_first() {
+        let future = "2050-01-01T00:00:00Z";
+        let legacy = compact("urn:passport:legacy", "renewal-not-a-license-ticket", future);
+        let service = compact("urn:passport:delegationcompact", "service-ticket", future);
+        assert_eq!(license_user_ticket(issued(vec![legacy, service])).unwrap(), "d=service-ticket");
+        let jwe = compact("urn:passport:delegationcompact", "eyJhbGciOiJub25lIn0.payload.sig", future);
+        assert_eq!(license_user_ticket(issued(vec![jwe])).unwrap(), "eyJhbGciOiJub25lIn0.payload.sig");
+
+        let compact_ticket = compact("urn:passport:compact", "plain-service-ticket", future);
+        let legacy = compact("urn:passport:legacy", "renewal-not-a-license-ticket", future);
+        assert_eq!(license_user_ticket(issued(vec![compact_ticket, legacy])).unwrap(), "plain-service-ticket");
+    }
+
+    #[test]
+    fn license_ticket_rejects_a_renewal_fault_or_ambiguous_service_token() {
+        let future = "2050-01-01T00:00:00Z";
+        let legacy = compact("urn:passport:legacy", "renewal-only", future);
+        assert!(license_user_ticket(issued(vec![legacy])).is_err());
+        assert!(license_user_ticket(ExchangeUserTokenOutcome::Fault(None)).is_err());
+        let first = compact("urn:passport:compact", "one", future);
+        let second = compact("urn:passport:compact", "two", future);
+        assert!(license_user_ticket(issued(vec![first, second])).is_err());
+        let expired = compact("urn:passport:compact", "stale", "2020-01-01T00:00:00Z");
+        assert!(license_user_ticket(issued(vec![expired])).is_err());
+    }
+}
